<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.pbinitiative.zenbpm</groupId>
    <artifactId>zenbpm-vanillabp-adapter-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>zenbpm-vanillabp-adapter</artifactId>
  <name>VanillaBP adapter for ZenBPM - Core</name>
  <description>Platform-neutral core of the VanillaBP adapter for ZenBPM</description>

  <dependencies>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-adapter-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>spi-for-java</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- the REST client's JSON. Jackson 2, because both platforms manage it: Quarkus
         uses it itself, Spring Boot 4 manages it beside its own Jackson 3. Declared
         'compile' here, the platform an application runs on decides the version. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- the job stream -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- filtered, so META-INF/vanillabp/adapter-zenbpm.properties names the versions this
         jar was built with -->
    <resources>
      <resource>
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
      </resource>
      <!-- repeated from the root POM, which this <resources> replaces -->
      <resource>
        <targetPath>META-INF</targetPath>
        <directory>${maven.multiModuleProjectDirectory}</directory>
        <includes>
          <include>LICENSE</include>
          <include>LICENSE-APACHE-2.0</include>
          <include>NOTICE</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
